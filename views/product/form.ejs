<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
  <main class="page-shell form-shell">
    <a class="back-link" href="/products">&larr; Back to products</a>
    <header class="page-header form-header">
      <div>
        <p class="eyebrow">CATALOG MANAGEMENT</p>
        <h1><%= title %></h1>
        <p class="subtitle">Enter the product details below.</p>
      </div>
    </header>

    <form class="product-form" action="<%= action %>" method="post">
      <% if (error) { %><p class="form-error" role="alert"><%= error %></p><% } %>
      <label for="name">Product name</label>
      <input id="name" name="name" type="text" maxlength="120" value="<%= product.name || '' %>" required autofocus>

      <label for="description">Description <span class="optional">OPTIONAL</span></label>
      <textarea id="description" name="description" rows="5" maxlength="2000"><%= product.description || '' %></textarea>

      <label for="price">Price</label>
      <div class="price-input"><span>$</span><input id="price" name="price" type="number" min="0" step="0.01" value="<%= product.price == null ? '' : product.price %>" required></div>

      <div class="form-actions">
        <a class="button button-secondary" href="/products">Cancel</a>
        <button class="button button-primary" type="submit"><%= submitLabel %></button>
      </div>
    </form>
  </main>
</body>
</html>